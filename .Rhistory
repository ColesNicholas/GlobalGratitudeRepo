dataframe$rank <- rank(dataframe$Pain)
# Calculate sum of ranks for each group
sum_ranks <- tapply(dataframe$rank, dataframe$TensUnit, sum)
# Calculate expected sum of ranks
n1 <- sum(dataframe$TensUnit == unique(dataframe$TensUnit)[1])
n2 <- sum(dataframe$TensUnit == unique(dataframe$TensUnit)[2])
N <- n1 + n2
expected_ranks <- n1 * (N + 1) / 2
# Calculate z-obtained
z_obtained <- (sum_ranks[1] - expected_ranks) / sqrt(n1 * n2 * (N + 1) / 12)
# Calculate eta-squared
eta_squared <- (z_obtained^2) / (N + 1)
# Print eta-squared results
cat("Eta-squared:", eta_squared, "\n")
