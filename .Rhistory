data = viz.DF,
aes(
y = fct_rev(outcome),
x = opposite_distribution,
label = countries
)
) +
geom_col(
alpha = .5,
fill = "gray30"
) +
geom_text(aes(x = 18),
size = 3,
hjust = 0,
color = "#3C5488"
) +
# vertical line
geom_segment(x = 57, xend = 57, y = 0.5, yend = 6, color = "gray30") +
# top horizontal
geom_segment(x = 56, xend = 57, y = 6, yend = 0.5, color = "gray30") +
# bottom horizontal
geom_segment(x = 56, xend = 57, y = 0.5, yend = 0.5, color = "gray30") +
geom_text(
aes(
x = 58,
y = length(unique(outcome)) / 1.9
),
label = "Theory-inconsistent observations",
hjust = 0,
size = 3
) +
theme_classic() +
xlim(0, 100) +
xlab("Theory-inconsistent proportion of estimated distribution") +
ylab("Outcome")
fig.3a
