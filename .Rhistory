mid = "white",
high = "#66C2A5",
midpoint = 0,
limits = c(-.5, .5), # adjust limits to correlation range
name = expression("Pearson's " * italic("r"))
) +
# Text labels for Bayes factor
geom_text(
aes(label = bf.lab),
parse = TRUE,
nudge_y = -0.25,
size = 6 / .pt
) +
# Text labels for correlation
geom_text(
aes(label = cor.lab),
parse = TRUE,
nudge_y = 0.25,
size = 6 / .pt
) +
theme_classic() +
labs(
y = expression("Country-Level Overall Effects (" * italic("d") * ")"),
x = "Country-Level Differences",
fill = expression("Pearson's " * italic("r"))
) +
theme(
axis.line = element_blank(),
axis.ticks = element_blank(),
plot.background = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1, size = 6),
axis.text.y = element_text(size = 6),
axis.title.x = element_text(size = 6),
axis.title.y = element_text(size = 6),
legend.title = element_text(size = 6, margin = margin(b = 15)),
legend.text = element_text(size = 6),
legend.key.size = unit(0.4, "cm")
)
fig.3c
# Open data
df <-
read.csv(file = here(
"data/output",
"unique_country_effect_sizes.csv"
)) %>%
select(country:ss_var)
# List of effect size columns and variance columns
effect_size_columns <- c(
"pa_effect_size", "na_effect_size",
"optimistic_effect_size", "ls_effect_size",
"envy_effect_size", "indebted_effect_size"
)
variance_columns <- c(
"pa_var", "na_var", "optimistic_var",
"ls_var", "envy_var", "indebted_var"
)
# Estimate total heterogeneity
m <- lapply(1:length(effect_size_columns), function(i) {
rma.mv(
yi = df[[effect_size_columns[i]]],
V = df[[variance_columns[i]]],
data = df
)
})
m.c <- lapply(1:length(effect_size_columns), function(i) {
rma.mv(
yi = df[[effect_size_columns[i]]],
V = df[[variance_columns[i]]],
random = ~ 1 | country,
data = df
)
})
m.i <- lapply(1:length(effect_size_columns), function(i) {
rma.mv(
yi = df[[effect_size_columns[i]]],
V = df[[variance_columns[i]]],
random = ~ 1 | intervention_condition,
data = df
)
})
# Fit models for each pair of effect size and variance
m.ic <- lapply(1:length(effect_size_columns), function(i) {
rma.mv(
yi = df[[effect_size_columns[i]]],
V = df[[variance_columns[i]]],
random = list(~ 1 | intervention_condition, ~ 1 | country),
data = df
)
})
# Store the results
names(m.ic) <- paste(effect_size_columns)
# Calculate country-level descriptives
d.c <- lapply(effect_size_columns, function(effect_size) {
d.c <- df %>%
group_by(country) %>%
summarise(m = mean(.data[[effect_size]]), .groups = "drop") %>%
# add [jittered] y-value
mutate(
effect_size = effect_size,
y = -0.03 + runif(n(), min = -0.01, max = 0)
) %>%
# labels most extreme observations
mutate(
label = if_else(m == min(m),
true = country,
false = ""
),
label = if_else(m == max(m),
true = country,
false = label
)
) %>%
# include effect size namece
mutate(effect_size = effect_size)
return(d.c)
})
View(d.c)
# Calculate intervention-level descriptives
d.i <- lapply(effect_size_columns, function(effect_size) {
d.i <- df %>%
group_by(intervention_condition) %>%
summarise(m = mean(.data[[effect_size]]), .groups = "drop") %>%
# add [jittered] y-value
mutate(
y = -0.02,
y = jitter(y, .1)
) %>%
# mutate intervention names
mutate(
intervention_condition = recode(
intervention_condition,
"text" = "Gratitude Text",
"letter" = "Gratitude Letter",
"naikan" = "Naikan Reflection",
"mental.sub" = "Mental Subtraction",
"divine.grat" = "Divine Gratitude",
"list" = "Gratitude List"
)
) %>%
# labels most extreme observations
mutate(
label = if_else(m == min(m),
true = intervention_condition,
false = ""
),
label = if_else(m == max(m),
true = intervention_condition,
false = label
)
) %>%
# include effect size name
mutate(effect_size = effect_size)
return(d.i)
})
# Calculate total descriptives
d.all <- lapply(effect_size_columns, function(effect_size) {
df %>%
group_by(country, intervention_condition) %>%
summarise(m = mean(.data[[effect_size]]), .groups = "drop") %>%
# mutate intervention names
mutate(
intervention_condition = recode(
intervention_condition,
"text" = "Gratitude Text",
"letter" = "Gratitude Letter",
"naikan" = "Naikan Reflection",
"mental.sub" = "Mental Subtraction",
"divine.grat" = "Divine Gratitude",
"list" = "Gratitude List"
)
) %>%
# Add jittered y-value
mutate(
effect_size = effect_size,
y = runif(n(), min = -0.01, max = 0),
# Label extreme values
label = if_else(
m == min(m),
paste0(country, ",\n", intervention_condition), ""
),
label = if_else(
m == max(m),
paste0(country, ",\n", intervention_condition),
label
)
)
})
# Bind rows
d.c <- bind_rows(d.c)
d.i <- bind_rows(d.i)
d.all <- bind_rows(d.all)
View(d.all)
# Effect size estimates + CI + p-value
results_df <- do.call(rbind, lapply(names(m.ic), function(name) {
model <- m.ic[[name]]
# extract estimate (Cohen's d or intercept)
est <- as.numeric(coef(model))
# standard error
se <- sqrt(diag(vcov(model)))[1]
# 95% confidence interval
ci_lower <- est - 1.96 * se
ci_upper <- est + 1.96 * se
# two-sided p-value (Wald test)
z_value <- est / se
p_value <- 2 * (1 - pnorm(abs(z_value)))
# formatted label for geom_text
label <- sprintf(
"italic(d) == %.2f * ', 95%% CI [%.2f, %.2f]'",
est, ci_lower, ci_upper
)
# Extract tau values
tau_i <- sqrt(model$sigma2[1])
tau_c <- sqrt(model$sigma2[2])
# formatted label for geom_text
tau_i_label <- sprintf(
"tau[practice] == %.2f",
tau_i
)
# formatted label for geom_text
tau_c_label <- sprintf(
"tau[country] == %.2f",
tau_c
)
# return as data frame
data.frame(
outcome = name,
estimate = round(est, 2),
ci_lower = round(ci_lower, 2),
ci_upper = round(ci_upper, 2),
p_value = p_value,
tau_i = round(tau_i, 2),
tau_c = round(tau_c, 2),
tau_ci = round(tau_c / tau_i, 2),
cohen_label = label,
tau_i_label = tau_i_label,
tau_c_label = tau_c_label
)
}))
# Create titles
outcome <- c(
"Positive Affect",
"Negative Affect",
"Optimism",
"Life Satisfaction",
"Envy",
"Indebtedness"
)
# Replace the outcome column in results_df
results_df$outcome <- outcome
country.DF <-
country_results_df %>%
arrange(desc(pa_effect_size))
View(country.DF)
write.csv(country.DF,
file = here(
"data/output",
"country_effectsize_outcomes.csv"
)
)
