layer_spatial(
data = world %>% filter(iso_a3 %in% sampled_iso),
aes(fill = iso_a3)
) +
# Use equal-area projection
coord_sf(crs = "ESRI:54030") +
# Minimal theme, remove legend and axes
theme_void() + # removes axes, gridlines, and background
theme(legend.position = "none")
