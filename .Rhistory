show.legend = TRUE
) +
# Fill gradient now for correlation
scale_fill_gradient2(
low = "#d73027", mid = "white", high = "#4575b4",
midpoint = 0,
limits = c(-.5, .5), # adjust limits to correlation range
name = expression("Pearson's " * italic("r"))
) +
# Text labels for Bayes factor
geom_text(
aes(label = bf.lab),
parse = TRUE,
nudge_y = -0.25,
size = 3.5
) +
# Text labels for correlation
geom_text(
aes(label = cor.lab),
parse = TRUE,
nudge_y = 0.25,
size = 3.5
) +
theme_classic() +
labs(
y = expression("Country-Level Effects of Gratitude Interventions (" * italic("d") * ")"),
x = "Country-Level Differences",
fill = expression("Pearson's " * italic("r"))
) +
theme(
axis.line = element_blank(),
axis.ticks = element_blank(),
plot.background = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
legend.title = element_text(size = 10, margin = margin(b = 15)),
legend.key.size = unit(0.6, "cm")
)
# Create figure 3c
fig.3c <- ggplot(
data = results,
aes(
x = moderator,
y = fct_rev(outcome),
fill = cor.est,
label = bf.lab
)
) +
geom_tile(
aes(fill = cor.est),
color = "white",
width = 0.97, height = 0.97,
show.legend = TRUE
) +
# Fill gradient now for correlation
scale_fill_gradient2(
low = "#d73027", mid = "white", high = "#4575b4",
midpoint = 0,
limits = c(-.5, .5), # adjust limits to correlation range
name = expression("Pearson's " * italic("r"))
) +
# Text labels for Bayes factor
geom_text(
aes(label = bf.lab),
parse = TRUE,
nudge_y = -0.25,
size = 3.5
) +
# Text labels for correlation
geom_text(
aes(label = cor.lab),
parse = TRUE,
nudge_y = 0.25,
size = 3.5
) +
theme_classic() +
labs(
y = expression("Country-Level Effects of Gratitude Interventions (" * italic("d") * ")"),
x = "Country-Level Differences",
fill = expression("Pearson's " * italic("r"))
) +
theme(
axis.line = element_blank(),
axis.ticks = element_blank(),
plot.background = element_blank(),
axis.text.x = element_text(angle = 45, hjust = 1),
legend.title = element_text(size = 10, margin = margin(b = 15)),
legend.key.size = unit(0.6, "cm")
)
plot_grid(plot_grid(fig.3a,
ggdraw(),
fig.3b,
labels = c("A", "", "B"),
nrow = 1,
rel_widths = c(.49, .02, .49)),
ggdraw(),
plot_grid(fig.3c,
labels = c("C")),
nrow = 3,
rel_heights = c(.3, .05, .75))
i.DF <-
read.csv(file = here(
"data",
"output",
"intervention_effectsizes.csv"
)) %>%
mutate(
se = sqrt(overall.var),
ci_lower = overall.effect - 1.96 * se,
ci_upper = overall.effect + 1.96 * se
) %>%
arrange(overall.effect)
i.DF <-
i.DF %>%
mutate(intervention_condition =
factor(intervention_condition,
levels = c("list",
"divine.grat",
"mental.sub",
"naikan",
"letter",
"text"),
labels = c('Gratitude List',
'Divine Gratitude',
'Mental Subtraction',
'Naikan Reflection',
'Gratitude Letter',
'Gratitude Text')
)
)
fig.3a <- ggplot(
data = i.DF,
aes(
x = overall.effect,
y = intervention_condition
)
) +
geom_segment(
aes(
x = ci_lower,
xend = ci_upper,
color = "#E64B35"
)
) +
geom_point(
shape = 18,
size = 4,
color = "#E64B35"
) +
xlim(c(0, .6)) +
xlab(expression(paste("Cohen's ", italic("d")))) +
ylab("Practice") +
theme_classic() +
theme(legend.position = "none") +
geom_vline(
xintercept = 0,
color = "gray30",
linetype = "dotted"
)
fig.3a
plot_grid(plot_grid(fig.3a,
ggdraw(),
fig.3b,
labels = c("A", "", "B"),
nrow = 1,
rel_widths = c(.49, .02, .49)),
ggdraw(),
plot_grid(fig.3c,
labels = c("C")),
nrow = 3,
rel_heights = c(.3, .05, .75))
