calc_var <- function(d, n1, n2) {
se_d <- sqrt((n1 + n2) / (n1 * n2) + d^2 / (2 * (n1 + n2)))
return(se_d^2)
}
# loop through each measure
effects <- sapply(variables, function(measure) {
d_result <- effsize::cohen.d(
intervention_subset[[measure]],
control_subset[[measure]],
pooled = TRUE,
hedges.correction = FALSE
)
d_value <- d_result$estimate
var_value <- calc_var(d_value, nrow(control_subset), nrow(intervention_subset))
c(d_value, var_value)
})
# split into vectors
effect_sizes <- effects[1, ]
variances <- effects[2, ]
# create result
result <- data.frame(
intervention_condition = intervention_cond,
as.list(setNames(effect_sizes, paste0(gsub("_mean", "", variables), "_effect_size"))),
as.list(setNames(variances, paste0(gsub("_mean", "", variables), "_var"))),
stringsAsFactors = FALSE
)
return(result)
}
# Loop through contrasts
results_list <- list()
country_data <- DF
intervention_conditions <-
unique(country_data$condition[country_data$condition_type == "intervention"])
for (intervention_cond in intervention_conditions) {
results_list[[length(results_list) + 1]] <-
compute_effect_sizes(intervention_cond)
}
# Combine all results
unique_results_df <- do.call(rbind, results_list)
# process
unique_results_df <-
unique_results_df %>%
rowwise() %>%
mutate(
overall.effect =
mean(c(
pa_effect_size,
(na_effect_size * -1),
optimistic_effect_size,
ls_effect_size,
(envy_effect_size * -1),
indebted_effect_size
)),
overall.var =
mean(c(
pa_var,
na_var,
optimistic_var,
ls_var,
envy_var,
indebted_var
))
) %>%
select(intervention_condition, overall.effect, overall.var) %>%
arrange(desc(overall.effect))
# Chunk 5
# export
write.csv(unique_results_df,
here(
"data",
"output",
"intervention_effectsizes.csv"
),
row.names = F
)
# Chunk 6
# Initialize data frame
unique_country_results_df <- data.frame()
# Compute Cohen's d and variance
compute_effect_sizes <- function(lab_name, control_cond, intervention_cond) {
# subset data
country_data <- DF %>% filter(country == lab_name)
control_subset <- country_data %>% filter(condition == control_cond)
intervention_subset <- country_data %>% filter(condition == intervention_cond)
# calculate variance
calc_var <- function(d, n1, n2) {
se_d <- sqrt((n1 + n2) / (n1 * n2) + d^2 / (2 * (n1 + n2)))
return(se_d^2)
}
# loop through each measure
effects <- sapply(variables, function(measure) {
d_result <- effsize::cohen.d(
intervention_subset[[measure]],
control_subset[[measure]],
pooled = TRUE,
hedges.correction = FALSE
)
d_value <- d_result$estimate
var_value <- calc_var(d_value, nrow(control_subset), nrow(intervention_subset))
c(d_value, var_value)
})
# split into vectors
effect_sizes <- effects[1, ]
variances <- effects[2, ]
# create result
result <- data.frame(
country = lab_name,
control_condition = control_cond,
intervention_condition = intervention_cond,
contrast = paste(control_cond, "vs", intervention_cond),
as.list(setNames(effect_sizes, paste0(gsub("_mean", "", variables), "_effect_size"))),
as.list(setNames(variances, paste0(gsub("_mean", "", variables), "_var"))),
stringsAsFactors = FALSE
)
return(result)
}
# Loop through countries and contrasts
results_list <- list()
for (lab_name in unique_labs) {
country_data <- DF %>% filter(country == lab_name)
control_conditions <- unique(country_data$condition[country_data$condition_type == "control"])
intervention_conditions <- unique(country_data$condition[country_data$condition_type == "intervention"])
for (control_cond in control_conditions) {
for (intervention_cond in intervention_conditions) {
results_list[[length(results_list) + 1]] <- compute_effect_sizes(lab_name, control_cond, intervention_cond)
}
}
}
# Combine all results
unique_country_results_df <- do.call(rbind, results_list)
# Chunk 7
write.csv(unique_country_results_df,
file = here(
"data/output",
"unique_country_effect_sizes.csv"
)
)
# Chunk 8
# Initialize data frame
country_results_df <- data.frame()
results_list <- list()
compute_effect_sizes <- function(lab_name) {
# subset data
country_data <- DF %>% filter(country == lab_name)
control_subset <- country_data %>%
filter(condition_type == "control")
intervention_subset <- country_data %>%
filter(condition_type == "intervention")
# loop through each measure
results <- lapply(variables, function(measure) {
test <- t.test(
intervention_subset[[measure]],
control_subset[[measure]],
var.equal = TRUE
)
data.frame(
outcome = gsub("_mean", "", measure),
country = lab_name,
estimate = diff(test$estimate),
SE = test$stderr,
df = test$parameter,
t.ratio = test$statistic,
p.value = test$p.value,
stringsAsFactors = FALSE
)
})
do.call(rbind, results)
}
# Loop through countries
for (lab_name in unique_labs) {
results_list[[length(results_list) + 1]] <- compute_effect_sizes(lab_name)
}
# Combine all results
country_results_df <- do.call(rbind, results_list)
country_results_df <- country_results_df %>%
mutate(
p.value = stars.pval(p.value),
estimate = round(estimate, 2),
SE = round(SE, 2),
df = round(df, 2),
t.ratio = round(t.ratio, 2)
)
# Set outcome order
country_results_df$outcome <- factor(
country_results_df$outcome,
levels = gsub("_mean", "", variables)
)
# Arrange by outcome order then country
country_results_df <- country_results_df %>%
arrange(outcome, country)
