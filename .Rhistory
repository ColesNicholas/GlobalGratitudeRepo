calculate_effect_sizes <- function(data, dv, iv1, iv2) {
# Perform ANOVA
anova_result <- aov(as.formula(paste(dv, "~", iv1, "*", iv2)), data = data)
anova_summary <- summary(anova_result)
print(anova_summary)
mse <- anova_summary[[1]]["Residuals", "Mean Sq"]
print(paste("Mean Squared Error (MSE):", mse))
# Calculate grand mean
grand_mean <- mean(data[[dv]], na.rm = TRUE)
print(paste("Grand Mean:", grand_mean))
# Calculate means for each level of iv1
means_iv1 <- data %>%
group_by(!!sym(iv1)) %>%
summarise(mean_dv = mean(!!sym(dv), na.rm = TRUE), .groups = 'drop')
print(paste("Means for each level of", iv1, ":"))
print(means_iv1)
# Calculate means for each level of iv2
means_iv2 <- data %>%
group_by(!!sym(iv2)) %>%
summarise(mean_dv = mean(!!sym(dv), na.rm = TRUE), .groups = 'drop')
print(paste("Means for each level of", iv2, ":"))
print(means_iv2)
# Calculate means for each combination of iv1:iv2
means_combination <- data %>%
group_by(!!sym(iv1), !!sym(iv2)) %>%
summarise(mean_dv = mean(!!sym(dv), na.rm = TRUE), .groups = 'drop')
print(paste("Means for each combination of", iv1, "and", iv2, ":"))
print(means_combination)
# Save the number of levels for iv1 and iv2
k1 <- nlevels(data[[iv1]])
print(paste("Number of levels for", iv1, "(k1):", k1))
k2 <- nlevels(data[[iv2]])
print(paste("Number of levels for", iv2, "(k2):", k2))
# Function to calculate Cohen's f for main effects
calculate_cohens_f_main <- function(means, grand_mean, k, mse) {
sum_sq_diff <- sum((means$mean_dv - grand_mean)^2)
cohens_f <- sqrt(sum_sq_diff / (k * mse))
return(cohens_f)
}
# Calculate Cohen's f for iv1
cohens_f_iv1 <- calculate_cohens_f_main(means_iv1, grand_mean, k1, mse)
print(paste("Cohen's f for", iv1, ":", cohens_f_iv1))
# Calculate Cohen's f for iv2
cohens_f_iv2 <- calculate_cohens_f_main(means_iv2, grand_mean, k2, mse)
print(paste("Cohen's f for", iv2, ":", cohens_f_iv2))
# Function to calculate Cohen's f for interaction
calculate_cohens_f_interaction <- function(means_combination, means_iv1, means_iv2, grand_mean, k1, k2, mse) {
sum_sq_diff <- 0
for (i in 1:nrow(means_combination)) {
cell_mean <- means_combination$mean_dv[i]
iv1_mean <- means_iv1$mean_dv[means_iv1[[iv1]] == means_combination[[iv1]][i]]
iv2_mean <- means_iv2$mean_dv[means_iv2[[iv2]] == means_combination[[iv2]][i]]
sum_sq_diff <- sum_sq_diff + (cell_mean - iv1_mean - iv2_mean + grand_mean)^2
}
cohens_f <- sqrt(sum_sq_diff / (k1 * k2 * mse))
return(cohens_f)
}
# Calculate Cohen's f for interaction
cohens_f_interaction <- calculate_cohens_f_interaction(means_combination, means_iv1, means_iv2, grand_mean, k1, k2, mse)
print(paste("Cohen's f for interaction between", iv1, "and", iv2, ":", cohens_f_interaction))
# Function to calculate Cohen's d for two-level factors
calculate_cohens_d <- function(data, dv, iv) {
levels <- levels(data[[iv]])
group1 <- data %>% filter(!!sym(iv) == levels[1]) %>% pull(!!sym(dv))
group2 <- data %>% filter(!!sym(iv) == levels[2]) %>% pull(!!sym(dv))
mean_diff <- mean(group1) - mean(group2)
pooled_sd <- sqrt(((length(group1) - 1) * var(group1) + (length(group2) - 1) * var(group2)) / (length(group1) + length(group2) - 2))
cohens_d <- mean_diff / pooled_sd
return(cohens_d)
}
# Calculate Cohen's d for iv1 if it has two levels
if (k1 == 2) {
cohens_d_iv1 <- calculate_cohens_d(data, dv, iv1)
print(paste("Cohen's d for", iv1, ":", cohens_d_iv1))
}
# Calculate Cohen's d for iv2 if it has two levels
if (k2 == 2) {
cohens_d_iv2 <- calculate_cohens_d(data, dv, iv2)
print(paste("Cohen's d for", iv2, ":", cohens_d_iv2))
}
# Return results as a list
return(list(
grand_mean = grand_mean,
means_iv1 = means_iv1,
means_iv2 = means_iv2,
means_combination = means_combination,
k1 = k1,
k2 = k2,
mse = mse,
cohens_f_iv1 = cohens_f_iv1,
cohens_f_iv2 = cohens_f_iv2,
cohens_f_interaction = cohens_f_interaction,
cohens_d_iv1 = if (k1 == 2) cohens_d_iv1 else NA,
cohens_d_iv2 = if (k2 == 2) cohens_d_iv2 else NA
))
}
results <- calculate_effect_sizes(dataframe, "Pain", "Med", "TensUnit")
library(pwr)
mu0 <- c(57.6, 45.7, 57.3, 56.8)
mu0.sd <- c(9.64, 9.39, 9.64, 9.39)
mu0.n <- c(8, 8, 8, 8)
pooled_sd <- sqrt(sum((mu0.n - 1) * mu0.sd^2) / sum(mu0.n - 1))
pooled_sd
grand_mean <- sum(mu0.n * mu0) / sum(mu0.n)
# Sum of squares between groups
ssb <- sum(mu0.n * (mu0 - grand_mean)^2)
# Total sum of squares
sst <- sum((mu0.n - 1) * mu0.sd^2) + ssb
# Cohen's f
cohen_f <- sqrt(ssb / (sst - ssb))
cohen_f
sample_size_result <- pwr.anova.test(
k = length(mu0),
n = NULL,
f = cohen_f,
sig.level = 0.05,
power = 0.80
)
sample_size_result
library(pwr)
# Cohen's f values
f_values <- c(
Med = 0.306,
TensUnit = 0.349,
Med_TensUnit = 0.321
)
# Existing sample size
n_total <- 32
# Numerator df for each effect
u <- 1
# df_error = N - number of groups (k1 * k2 = 2*2 = 4)
df_error <- n_total - (2*2)
# Compute power of existing design
power_existing <- sapply(f_values, function(f){
pwr.f2.test(
u = u,
v = df_error,
f2 = f^2,
sig.level = 0.05
)$power
})
# Compute required sample size for 80% power
target_power <- 0.80
required_n <- sapply(f_values, function(f){
result <- pwr.f2.test(
u = u,
f2 = f^2,
sig.level = 0.05,
power = target_power
)
n_needed <- ceiling(result$v + u + 1)
return(n_needed)
})
# Combine results in a table
results_table <- data.frame(
Effect = names(f_values),
Cohen_f = f_values,
Power_existing = round(power_existing, 3),
N_for_80_power = required_n
)
results_table
# Combine results in a table
results_table <- data.frame(
Effect = names(f_values),
Cohen_f = f_values,
Existing_power = round(power_existing, 3),
Required_N = required_n
)
results_table
