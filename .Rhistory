scale = "medium",
returnclass = "sf"
)
# Fix missing ISO values in world data
world[world$name == "France", ]$iso_a3 <- "FRA"
world[world$name == "Norway", ]$iso_a3 <- "NOR"
# Filter sampled countries
sampled_iso <- DF %>%
filter(sample == "yes") %>%
pull(iso)
# Create fig.1b
fig.1b <- ggplot() +
# Base world map (all countries, no fill)
layer_spatial(
data = world,
color = NA
) +
